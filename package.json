{
  "name": "@masterportal/masterportalapi",
  "version": "2.63.0",
  "description": "Basic functions of the Masterportal as api",
  "homepage": "https://bitbucket.org/geowerkstatt-hamburg/masterportalapi#readme",
  "bugs": {
    "url": "https://bitbucket.org/geowerkstatt-hamburg/masterportalapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://bitbucket.org/geowerkstatt-hamburg/masterportalapi.git"
  },
  "license": "MIT",
  "author": "Implementierungspartnerschaft Masterportal <info@masterportal.org> (https://www.masterportal.org)",
  "type": "commonjs",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*"
  },
  "main": "src/index.js",
  "directories": {
    "doc": "docs",
    "example": "example",
    "test": "test"
  },
  "scripts": {
    "test": "jest .test.js --config ./jest.config.js --collectCoverage",
    "test:trace": "node --trace-warnings node_modules/jest/bin/jest.js .test.js --config ./jest.config.js",
    "test:watch": "jest .test.js --config ./jest.config.js --watch",
    "example": "parcel example/index.html",
    "generate-jsdoc": "jsdoc ./src -r -d ./docs/ -R ./README.md -c jsdoc.json",
    "prePushHook": "eslint --max-warnings 0 \"./**/*.js\" && npm run test",
    "prepare": "husky install"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "dayjs": "^1.11.21",
    "ol": "10.9.0",
    "ol-mapbox-style": "13.3.0",
    "olcs": "^2.23.0",
    "proj4": "^2.20.9"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@swc/jest": "^0.2.39",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "canvas": "3.2.3",
    "eslint": "8.57.1",
    "events": "^3.3.0",
    "https-browserify": "^1.0.0",
    "husky": "8.0.3",
    "jest": "30.4.2",
    "jest-canvas-mock": "2.5.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-fetch-mock": "^3.0.3",
    "jsdoc": "4.0.5",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "sass": "1.101.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "timers-browserify": "^2.0.12",
    "url": "^0.11.4",
    "use-resize-observer": "^9.1.0",
    "util": "^0.12.5"
  },
  "peerDependencies": {
    "@cesium/engine": "^26.0.0"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.1",
    "npm": "^10.5.0 || ^11.6.2"
  },
  "source": "src/index.js",
  "targets": {
    "library": {
      "source": "src/index.js",
      "distDir": "dist",
      "outputFormat": "commonjs"
    },
    "main": false
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "alias": {
    "olcs/lib/olcs/util.js": "./node_modules/olcs/lib/olcs/util.js"
  }
}
